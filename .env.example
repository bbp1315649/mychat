# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# تنظیمات اتصال به دیتابیس Supabase (PostgreSQL)
# ==============================================================================

# ۱. روش اول (رشته اتصال استاندارد مستقیم یا Connection Pooler از بخش Database -> Connection string در پنل Supabase)
DATABASE_URL="postgresql://postgres:[YOUR-DATABASE-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ۲. اطلاعات پروژه و کلیدهای API سوپابیس (از بخش Settings -> API در پنل Supabase)
# Project URL:
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# API Key (anon / public):
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI..."
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI..."
